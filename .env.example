
# Copy this file to `.env.local` and fill in.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Core URLs & Domains
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_DOMAIN=example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_BASE_URL=http://localhost:3000
NEXT_APP_URL=http://app.localhost:3000
CRON_BASE_URL=https://app.example.com

# ─────────────────────────────────────────────────────────────
# Database (Postgres / Neon)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=
# Optional read replica for analytics-heavy reads
DATABASE_REPLICA_URL=

# ─────────────────────────────────────────────────────────────
# Auth (Better Auth)
# ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://app.localhost:3000
EMAIL_VERIFICATION_CALLBACK=http://app.localhost:3000/email-verified
# Optional: HMAC secret for password-verified cookies (falls back to BETTER_AUTH_SECRET)
LINK_PASSWORD_COOKIE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="no-reply@example.com"

# ─────────────────────────────────────────────────────────────
# Billing (Polar)
# ─────────────────────────────────────────────────────────────
# sandbox | production
POLAR_MODE=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Optional: discount ID applied by the GETPRO promo
POLAR_PROMO_DISCOUNT_ID=
# Price IDs are auto-synced from the Polar API by the webhook handlers.
# Set them here only to override / seed a fresh DB.
NEXT_PUBLIC_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_BUSINESS_MONTHLY_PRICE_ID=
NEXT_PUBLIC_BUSINESS_YEARLY_PRICE_ID=
# Legacy lifetime-Basic plan (grandfathered only)
NEXT_PUBLIC_BASIC_PRICE_ID=

# ─────────────────────────────────────────────────────────────
# Cache & Queues (Upstash Redis / QStash)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=
QSTASH_TOKEN=
# Used when QSTASH_TOKEN is absent
UPSTASH_QSTASH_REST_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# Background Jobs (Inngest)
# ─────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# Analytics (Tinybird)
# ─────────────────────────────────────────────────────────────
TINYBIRD_TOKEN=
TINYBIRD_URL=https://api.us-east.aws.tinybird.co
# Optional fallback (legacy). Prefer TINYBIRD_TOKEN.
TINYBIRD_API_KEY=
# Classic workspace token — only for one-shot migrate-classic-to-forward.mts
TINYBIRD_CLASSIC_TOKEN=

# ─────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional override for AI slug model (default tries flash-lite first)
# GEMINI_SLUG_MODEL=gemini-2.5-flash-lite

# ─────────────────────────────────────────────────────────────
# Cloudflare (R2 storage)
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# Vercel (custom domains)
# ─────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ─────────────────────────────────────────────────────────────
# Link Safety & Misc
# ─────────────────────────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_CLIENT_ID=
DYMO_API_KEY=

# ─────────────────────────────────────────────────────────────
# Monitoring (Sentry / APM)
# ─────────────────────────────────────────────────────────────
# Prefer `.env.sentry-build-plugin` for SENTRY_AUTH_TOKEN
SENTRY_AUTH_TOKEN=
APMINSIGHT_LICENSE_KEY=
APMINSIGHT_APP_NAME=slugy
APMINSIGHT_PORT=3000
